{
  "name": "@elizaos/app-steward",
  "version": "2.0.0-beta.1",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "bun": "./src/plugin.ts",
      "import": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    }
  },
  "dependencies": {
    "@elizaos/agent": "2.0.0-beta.1",
    "@elizaos/app-core": "2.0.0-beta.1",
    "@elizaos/core": "2.0.0-beta.1",
    "@elizaos/plugin-wallet": "2.0.0-beta.1",
    "@elizaos/ui": "2.0.0-beta.1",
    "@noble/curves": "2.2.0",
    "@simplewebauthn/browser": "^13.0.0",
    "@solana/web3.js": "1.98.4",
    "@stwd/sdk": "^0.8.1",
    "ethers": "^6.16.0",
    "lucide-react": "^1.0.0",
    "viem": "^2.48.8"
  },
  "elizaos": {
    "app": {
      "heroImage": "assets/hero.png"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "clean": "rm -rf dist",
    "build:js": "tsup --config ../tsup.plugin-packages.shared.ts",
    "build:types": "tsc --noCheck -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "_aliceSourceMainSentinel": "v1"
}
