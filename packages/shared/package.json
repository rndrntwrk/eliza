{
  "name": "@elizaos/shared",
  "version": "2.0.0-beta.1",
  "description": "Shared code for Eliza agent and app-core.",
  "type": "module",
  "main": "./src/index.ts",
  "license": "MIT",
  "homepage": "https://github.com/elizaOS/eliza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaOS/eliza.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "elizaos",
    "shared",
    "contracts",
    "i18n"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "build": "bun run build:i18n && bun run build:dist",
    "build:i18n": "node scripts/generate-keywords.mjs --target ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "lint": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write src",
    "format": "bunx @biomejs/biome format src",
    "format:fix": "bunx @biomejs/biome format --write src",
    "build:dist": "node ../../scripts/rm-path-recursive.mjs dist && tsc -p tsconfig.build.json && node ../../scripts/prepare-package-dist.mjs packages/shared",
    "pack:dry-run": "cd dist && npm pack --dry-run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./config/allowed-hosts": {
      "types": "./src/config/allowed-hosts.ts",
      "bun": "./src/config/allowed-hosts.ts",
      "import": "./src/config/allowed-hosts.ts",
      "default": "./src/config/allowed-hosts.ts"
    },
    "./dev-settings-banner-style": {
      "types": "./src/dev-settings-banner-style.ts",
      "bun": "./src/dev-settings-banner-style.ts",
      "import": "./src/dev-settings-banner-style.ts",
      "default": "./src/dev-settings-banner-style.ts"
    },
    "./dev-settings-figlet-heading": {
      "types": "./src/dev-settings-figlet-heading.ts",
      "bun": "./src/dev-settings-figlet-heading.ts",
      "import": "./src/dev-settings-figlet-heading.ts",
      "default": "./src/dev-settings-figlet-heading.ts"
    },
    "./dev-settings-table": {
      "types": "./src/dev-settings-table.ts",
      "bun": "./src/dev-settings-table.ts",
      "import": "./src/dev-settings-table.ts",
      "default": "./src/dev-settings-table.ts"
    },
    "./runtime-env": {
      "types": "./src/runtime-env.ts",
      "bun": "./src/runtime-env.ts",
      "import": "./src/runtime-env.ts",
      "default": "./src/runtime-env.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@elizaos/core": "2.0.0-beta.1",
    "chalk": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "bun-types": "^1.3.12",
    "typescript": "^6.0.3"
  },
  "types": "./src/index.ts",
  "_aliceSourceMainSentinel": "v1"
}
