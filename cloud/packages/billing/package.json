{
  "name": "@elizaos/billing",
  "version": "2.0.0-beta.1",
  "description": "Shared billing utilities for Eliza Cloud gateway services (platform markup arithmetic).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/rm-path-recursive.mjs dist && tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "_aliceSourceMainSentinel": "v1"
}
